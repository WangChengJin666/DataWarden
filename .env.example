# ============================================================
# DataWarden 环境变量模板
# ============================================================
# 使用方法：
#   1. 复制本文件为 .env.local
#      cp .env.example .env.local
#   2. 填写真实值
#   3. 每开一个新终端执行：source .env.local
#
# 注意：.env.local 已被 .gitignore 忽略，不会被提交。
# 本文件（.env.example）只放占位符，绝不写真实凭据。
# ============================================================

# ------------------------------------------------------------
# PostgreSQL
# ------------------------------------------------------------
# 应用运行时使用的库
DATABASE_URL="postgres://USER:PASSWORD@HOST:5432/datawarden?sslmode=disable"

# 集成测试专用库（必须与 DATABASE_URL 不同，测试会建表删表）
TEST_DATABASE_URL="postgres://USER:PASSWORD@HOST:5432/datawarden_test?sslmode=disable"

# ------------------------------------------------------------
# Redis
# ------------------------------------------------------------
# 格式：host:port/db
# 请使用独立 db（如 15），避免测试影响其他数据
TEST_REDIS_ADDR="HOST:6379/15"
# Redis 密码，无密码则留空
TEST_REDIS_PASSWORD=""

# ------------------------------------------------------------
# 应用配置
# ------------------------------------------------------------
# JWT 签名密钥，生产环境必须替换。生成：openssl rand -base64 48
JWT_SECRET="change-me"

HTTP_ADDR=":8080"
QUERY_TIMEOUT_SEC="30"
QUERY_ROW_LIMIT="500"
REDIS_SCAN_MAX_KEYS="200"

# Casbin 策略重建间隔（秒）。
# 授权带到期时间，但策略在内存里：只靠「审批通过时刷新」的话，
# 一条过期授权会一直生效到下次重启。默认 60 秒回收一次。
AUTHZ_REFRESH_SEC="60"

# ------------------------------------------------------------
# 数据源凭据
# ------------------------------------------------------------
# 每个数据源在界面上单独填写连接账号与密码，密码以【明文】存入 datasource 表。
# 平台不做应用层加密，因此：
#   * 平台元数据库必须限制 datasource 表的读权限
#   * 备份与 pg_dump 产物必须加密（文件里就有明文密码）
#   * 每个数据源请使用只读账号，不要用业务主账号
#
# 旧版本曾用 DATAWARDEN_MASTER_KEY 加密密码，该配置已废弃，
# 配了也不会生效（迁移 0004 会把 password_enc 改名为 password 并清空旧密文）。
