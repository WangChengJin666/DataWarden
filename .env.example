# ============================================================
# DataWarden 环境变量模板
# ============================================================
# 使用方法：
#   1. 复制本文件为 .env.local
#      cp .env.example .env.local
#   2. 填写真实值
#   3. 每开一个新终端执行：source .env.local
#
# 注意：.env.local 已被 .gitignore 忽略，不会被提交。
# 本文件（.env.example）只放占位符，绝不写真实凭据。
# ============================================================

# ------------------------------------------------------------
# PostgreSQL
# ------------------------------------------------------------
# 应用运行时使用的库
DATABASE_URL="postgres://USER:PASSWORD@HOST:5432/datawarden?sslmode=disable"

# 集成测试专用库（必须与 DATABASE_URL 不同，测试会建表删表）
TEST_DATABASE_URL="postgres://USER:PASSWORD@HOST:5432/datawarden_test?sslmode=disable"

# ------------------------------------------------------------
# Redis
# ------------------------------------------------------------
# 格式：host:port/db
# 请使用独立 db（如 15），避免测试影响其他数据
TEST_REDIS_ADDR="HOST:6379/15"
# Redis 密码，无密码则留空
TEST_REDIS_PASSWORD=""

# ------------------------------------------------------------
# 应用配置
# ------------------------------------------------------------
# JWT 签名密钥，生产环境必须替换。生成：openssl rand -base64 48
JWT_SECRET="change-me"

HTTP_ADDR=":8080"
QUERY_TIMEOUT_SEC="30"
QUERY_ROW_LIMIT="500"
REDIS_SCAN_MAX_KEYS="200"

# ------------------------------------------------------------
# 数据源密码加密主密钥
# ------------------------------------------------------------
# 必须是 16 / 24 / 32 字节（对应 AES-128/192/256，推荐 32）。
# 生成方式：openssl rand -base64 24 | cut -c1-32
#
# 作用：数据源的连接密码用此密钥加密后才存进 datasource 表。
# 数据库被拖走但主密钥不在，密码就不会泄露。
#
# 注意：一旦有数据源保存过密码就不能再改这个值，
# 否则旧密文全部解不开。轮换需要先解密再重新加密。
DATAWARDEN_MASTER_KEY="change-me-32-bytes-please-xxxxxx"

# 旧的全局查询账号，已废弃。
# 现在每个数据源在界面上单独配置账号密码，下面两项不再使用。
QUERY_DB_USER=""
QUERY_DB_PASSWORD=""
